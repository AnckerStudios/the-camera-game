;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TheCameraGame"
run/main_scene="uid://dkfij74x60580"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://resources/texture/icon.svg"

[audio]

buses/default_bus_layout="uid://l12p7u0id6b"

[autoload]

PlayerState="*res://gamelogic/player/player_state.gd"
TransitionTort="*uid://efpb6pdti1f2"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://gamelogic/input/": "pink",
"res://gamelogic/monster/": "yellow",
"res://gamelogic/player/": "green",
"res://gamelogic/player/camera/": "blue",
"res://gamelogic/player/cone/": "orange",
"res://gamelogic/weapon/": "red"
}

